const { execFile } = require('node:child_process');
const fs = require('node:fs');
const os = require('node:os');
const path = require('node:path');
const http = require('node:http');
const readline = require('node:readline');

const HOST = '127.0.0.1';
const PORT = 8765;
const DISCOVERY_SCRIPT = path.join(os.homedir(), 'src/android-adb-helpers/bin/adb-mdns-discover');
const PAIR_STATE_FILE = path.join(os.homedir(), '.shux-paired');

let state = 'main';
let busy = false;
let inputBuffer = '';
let output = '';
let message = 'Welcome to ShuX.';
let rl;
let server;


function runAdbRaw(args, timeout = 30000) {
  return new Promise((resolve, reject) => {
    execFile('adb', args, {
      timeout,
      maxBuffer: 1024 * 1024
    }, (error, stdout, stderr) => {
      const result = [stdout, stderr]
        .filter(Boolean)
        .join('\n')
        .trim();

      if (error) {
        reject(new Error(result || error.message));
      } else {
        resolve(result || '(No output)');
      }
    });
  });
}

async function adb(args, timeout = 30000) {
  if (!Array.isArray(args) || args.length === 0) {
    throw new Error('No ADB arguments supplied.');
  }

  const globalCommands = new Set([
    'devices',
    'connect',
    'pair',
    'disconnect',
    'start-server',
    'kill-server',
    'version',
    'help',
    'keygen',
    'pubkey',
    'server-status'
  ]);

  const first = args[0];

  // Commands that manage ADB itself or its connections
  // must not be assigned to a particular device.
  if (globalCommands.has(first)) {
    return runAdbRaw(args, timeout);
  }

  // Respect an explicit device selector supplied by the user.
  if (
    args.includes('-s') ||
    args.includes('-t') ||
    args.includes('-d') ||
    args.includes('-e')
  ) {
    return runAdbRaw(args, timeout);
  }

  // Find devices without applying automatic selection.
  const listing = await runAdbRaw(['devices', '-l'], 10000);

  const online = [];
  for (const line of listing.split(/\r?\n/).slice(1)) {
    const match = line.trim().match(/^(\S+)\s+device(?:\s|$)/);
    if (match) online.push(match[1]);
  }

  if (online.length === 0) {
    throw new Error(
      'No online ADB device found. Open Wireless debugging and reconnect.'
    );
  }

  if (online.length > 1) {
    throw new Error(
      'Multiple online ADB devices found: ' + online.join(', ') +
      '. Specify one with -s SERIAL.'
    );
  }

  // Exactly one online device: select it automatically.
  return runAdbRaw(['-s', online[0], ...args], timeout);
}

function parseArgs(line) {
  const args = [];
  const re = /"([^"]*)"|'([^']*)'|(\S+)/g;
  let match;

  while ((match = re.exec(line)) !== null) {
    args.push(match[1] ?? match[2] ?? match[3]);
  }

  if (args[0] === 'adb') args.shift();
  return args;
}

function clear() {
  process.stdout.write('\x1b[2J\x1b[H');
}

function render() {
  clear();

  console.log('================================');
  console.log('             ShuX');
  console.log('================================');
  console.log('');

  if (state === 'main') {
    console.log('MAIN MENU\n');
    console.log('1. Reconnect');
    console.log('2. Required Apps');
    console.log('3. ADB Commands');
    console.log('0. Exit\n');
    console.log('Enter an option number and press Enter.');
  } else if (state === 'reconnect') {
    console.log('RECONNECT\n');
    console.log('Checking ADB connection...');
  } else if (state === 'apps') {
    console.log('REQUIRED APPS\n');
    console.log('No app requests are registered yet.');
    console.log('The app authorization service is not implemented yet.\n');
    console.log('0. Main Menu');
  } else if (state === 'commands') {
    console.log('ADB COMMAND LINE\n');
    console.log('Enter ADB arguments directly.');
    console.log('Example: shell id');
    console.log('Example: devices\n');
    console.log('Type exit to return to the main menu.');
    console.log('Press Ctrl+B to return to the main menu.\n');
    console.log('shux> ' + inputBuffer);
  } else if (state === 'paircode') {
    console.log('WIRELESS DEBUGGING PAIRING\n');
    console.log('Enter the pairing code shown in Android settings.');
    console.log('Pairing port: ' + message + '\n');
    console.log('Pairing code: ' + inputBuffer);
  }

  if (output) {
    console.log('\n--------------------------------');
    console.log(output);
  }

  if (message && state !== 'paircode') {
    console.log('\n--------------------------------');
    console.log(message);
  }
}

function promptMain() {
  state = 'main';
  inputBuffer = '';
  message = 'Ready.';
  output = '';
  render();
}


function wasPaired() {
  try {
    return fs.readFileSync(PAIR_STATE_FILE, 'utf8').trim() === 'yes';
  } catch {
    return false;
  }
}

function markPaired() {
  fs.writeFileSync(PAIR_STATE_FILE, 'yes\n', { mode: 0o600 });
}

async function discoverServices(seconds = 3) {
  return new Promise((resolve, reject) => {
    execFile(
      'python',
      [DISCOVERY_SCRIPT, String(seconds)],
      { timeout: (seconds + 4) * 1000, maxBuffer: 1024 * 1024 },
      (error, stdout, stderr) => {
        if (error) {
          reject(new Error((stderr || stdout || error.message).trim()));
          return;
        }

        const services = {};

        for (const line of stdout.split(/\r?\n/)) {
          const match = line.trim().match(
            /^(pairing|connect)\s+(\S+)\s+(\d+)$/
          );

          if (match) {
            services[match[1]] = {
              host: match[2],
              port: Number(match[3]),
              address: `${match[2]}:${match[3]}`
            };
          }
        }

        resolve(services);
      }
    );
  });
}

async function getConnectedDevices() {
  const text = await adb(['devices']);
  return text.split(/\r?\n/).slice(1)
    .filter(line => /\bdevice$/.test(line.trim()));
}

async function tryDiscoveredConnection(services) {
  if (!services.connect) {
    return {
      connected: false,
      output: 'No connection service discovered.'
    };
  }

  try {
    const result = await adb(['connect', services.connect.address], 15000);
    const devices = await getConnectedDevices();

    if (devices.length) {
      markPaired();
      return {
        connected: true,
        output: result + '\n' + devices.join('\n')
      };
    }

    return { connected: false, output: result };
  } catch (e) {
    return { connected: false, output: e.message };
  }
}

async function reconnectFlow() {
  if (busy) return;

  busy = true;
  state = 'reconnect';
  inputBuffer = '';
  output = '';
  message = 'Discovering ADB services...';
  render();

  try {
    let services = await discoverServices(3);
    let result = await tryDiscoveredConnection(services);

    if (result.connected) {
      output = result.output;
      message = 'Connection successful.';
      busy = false;
      promptMain();
      return;
    }

    if (wasPaired()) {
      message = 'Retrying the existing paired connection...';
      render();

      services = await discoverServices(2);
      result = await tryDiscoveredConnection(services);

      output = result.output;
      message = result.connected
        ? 'Connection successful.'
        : 'Previously paired. Connection failed; pairing was not repeated.';

      busy = false;
      promptMain();
      return;
    }

    if (!services.pairing) {
      message = 'Searching for the pairing service...';
      render();

      const retry = await discoverServices(2);
      services = {
        pairing: retry.pairing || services.pairing,
        connect: retry.connect
      };

      result = await tryDiscoveredConnection(services);

      if (result.connected) {
        output = result.output;
        message = 'Connection successful.';
        busy = false;
        promptMain();
        return;
      }
    }

    if (services.pairing) {
      state = 'paircode';
      inputBuffer = '';
      output = '';
      message = services.pairing.address;
      busy = false;
      render();
      return;
    }

    output =
      'No pairing service was discovered.\n' +
      'Keep Wireless debugging enabled and the pairing dialog open, then retry.';
    message = 'Discovery failed.';
    busy = false;
    state = 'reconnect';
    render();
  } catch (e) {
    busy = false;
    state = 'reconnect';
    output = e.message;
    message = 'Reconnect failed.';
    render();
  }
}

async function finishPairing(code) {
  if (busy) return;

  if (!/^\d{6}$/.test(code)) {
    message = 'Enter the six-digit pairing code.';
    render();
    return;
  }

  const address = message;
  busy = true;
  state = 'reconnect';
  output = '';
  message = 'Pairing with Android...';
  render();

  try {
    output = await adb(['pair', address, code], 30000);
    markPaired();

    message = 'Pairing succeeded. Discovering connection service...';
    render();

    let services = await discoverServices(3);

    if (!services.connect) {
      const retry = await discoverServices(2);
      services = { ...services, connect: retry.connect };
    }

    if (!services.connect) {
      output += '\n\nPairing succeeded, but the connection service was not found.';
      message = 'Paired; connection is not yet confirmed.';
      busy = false;
      promptMain();
      return;
    }

    const result = await tryDiscoveredConnection(services);
    output += '\n' + result.output;
    message = result.connected
      ? 'Pairing and connection successful.'
      : 'Paired successfully, but connection failed.';

    busy = false;
    promptMain();
  } catch (e) {
    busy = false;
    state = 'reconnect';
    output = e.message;
    message = 'Pairing or connection failed.';
    render();
  }
}

async function executeCommand(line) {
  const args = parseArgs(line);

  if (!args.length) {
    state = 'commands';
    inputBuffer = '';
    render();
    return;
  }

  if (args[0] === 'exit' || args[0] === 'quit') {
    promptMain();
    return;
  }

  busy = true;
  output = '';
  message = 'Executing ADB command...';
  render();

  try {
    output = await adb(args);
    message = 'Command completed.';
  } catch (e) {
    output = 'ERROR: ' + e.message;
    message = 'Command failed.';
  }

  busy = false;
  state = 'commands';
  inputBuffer = '';
  render();
}

function handleEnter(value) {
  if (state === 'main') {
    if (value === '1') reconnectFlow();
    else if (value === '2') {
      state = 'apps';
      output = '';
      message = 'App authorization is not implemented yet.';
      render();
    } else if (value === '3') {
      state = 'commands';
      inputBuffer = '';
      output = '';
      message = 'Ready.';
      render();
    } else if (value === '0') {
      shutdown();
    } else {
      message = 'Invalid option. Try again.';
      render();
    }
  } else if (state === 'apps') {
    if (value === '0') promptMain();
    else {
      message = 'Invalid option. Enter 0 to return.';
      render();
    }
  } else if (state === 'commands') {
    executeCommand(value);
  } else if (state === 'paircode') {
    finishPairing(value);
  } else if (state === 'reconnect') {
    if (value === '0') promptMain();
    else reconnectFlow();
  }
}

function shutdown() {
  if (rl) rl.close();
  if (server) server.close();
  process.stdout.write('\x1b[?25h\x1b[2J\x1b[H');
  console.log('ShuX closed.');
  process.exit(0);
}

rl = readline.createInterface({
  input: process.stdin,
  output: process.stdout,
  terminal: true,
  prompt: ''
});

readline.emitKeypressEvents(process.stdin);

if (process.stdin.isTTY) {
  process.stdin.setRawMode(true);
}

process.stdin.on('keypress', (str, key) => {
  if (!key) return;

  if (key.ctrl && key.name === 'b') {
    busy = false;
    promptMain();
    return;
  }

  if (key.ctrl && key.name === 'c') {
    shutdown();
    return;
  }

  if (busy) return;

  if (key.name === 'return' || key.name === 'enter') {
    const value = inputBuffer.trim();
    inputBuffer = '';
    handleEnter(value);
    return;
  }

  if (key.name === 'backspace') {
    inputBuffer = inputBuffer.slice(0, -1);
    render();
    return;
  }

  if (str && !key.ctrl && !key.meta && str >= ' ') {
    inputBuffer += str;
    render();
  }
});

server = http.createServer(async (req, res) => {
  res.setHeader('Content-Type', 'application/json; charset=utf-8');

  if (req.method !== 'GET') {
    res.writeHead(405);
    return res.end(JSON.stringify({ error: 'Method not allowed' }));
  }

  try {
    if (req.url === '/health') {
      return res.end(JSON.stringify({ name: 'ShuX', status: 'running' }));
    }

    if (req.url === '/devices') {
      return res.end(JSON.stringify({ devices: await adb(['devices']) }));
    }

    if (req.url === '/identity') {
      return res.end(JSON.stringify({ identity: await adb(['shell', 'id']) }));
    }

    res.writeHead(404);
    res.end(JSON.stringify({ error: 'Not found' }));
  } catch (e) {
    res.writeHead(500);
    res.end(JSON.stringify({ error: e.message }));
  }
});

server.on('error', err => {
  if (err.code === 'EADDRINUSE') {
    console.log('\nNotice: local API port 8765 is already in use.');
    console.log('The ShuX terminal interface will still run.');
  } else {
    console.error(err.message);
  }
});

server.listen(PORT, HOST);

process.stdout.write('\x1b[?25l');
promptMain();
